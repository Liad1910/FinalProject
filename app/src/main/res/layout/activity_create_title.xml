<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7FB">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollCreate"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎬 הוספת כותרת"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#2B2B2B"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="הוסיפי סרט או סדרה — הפוסטר יובא אוטומטית 💖"
                android:textSize="13sp"
                android:textColor="#6B6B6B"
                android:layout_marginBottom="16dp"/>

            <!-- Card ראשי -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp"
                app:strokeWidth="1dp"
                app:strokeColor="#33FF69B4"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- שם -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="שם סרט / סדרה"
                        android:layout_marginBottom="10dp"
                        app:boxBackgroundMode="filled"
                        app:boxBackgroundColor="#FFF0F6"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:startIconDrawable="@android:drawable/ic_menu_edit"
                        app:startIconTint="#FF1493">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTitleName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#1F1F1F"
                            android:singleLine="true"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- שנה -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="שנה (רשות) – לדוגמה: 2020"
                        android:layout_marginBottom="16dp"
                        app:boxBackgroundMode="filled"
                        app:boxBackgroundColor="#FFF0F6"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:startIconDrawable="@android:drawable/ic_menu_today"
                        app:startIconTint="#FF1493">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTitleYear"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textColor="#1F1F1F"
                            android:singleLine="true"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- סוג -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="סוג"
                        android:textStyle="bold"
                        android:textColor="#2B2B2B"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp"/>

                    <RadioGroup
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="#FF1493"
                            app:cardBackgroundColor="#FFF0F6">

                            <RadioButton
                                android:id="@+id/rbMovie"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="🎬 Movie"
                                android:textStyle="bold"
                                android:textColor="#FF1493"
                                android:gravity="center"
                                android:padding="12dp"
                                android:buttonTint="#FF1493"/>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="#7C3AED"
                            app:cardBackgroundColor="#F5F0FF">

                            <RadioButton
                                android:id="@+id/rbSeries"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="📺 Series"
                                android:textStyle="bold"
                                android:textColor="#7C3AED"
                                android:gravity="center"
                                android:padding="12dp"
                                android:buttonTint="#7C3AED"/>
                        </com.google.android.material.card.MaterialCardView>

                    </RadioGroup>

                    <!-- ז'אנר -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ז׳אנר"
                        android:textStyle="bold"
                        android:textColor="#2B2B2B"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#DDDDDD"
                        app:cardBackgroundColor="#FFF0F6"
                        android:layout_marginBottom="10dp">

                        <Spinner
                            android:id="@+id/spGenre"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:entries="@array/genres_array"
                            android:padding="12dp"
                            android:background="@android:color/transparent"/>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ז'אנר שנבחר -->
                    <TextView
                        android:id="@+id/tvSelectedGenre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="Genre: לא נבחר"
                        android:textStyle="bold"
                        android:textColor="#7C3AED"
                        android:textSize="13sp"
                        android:background="#F5F0FF"
                        android:layout_marginBottom="16dp"/>

                    <!-- כפתור -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCreateTitle"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="✅ Create / Open"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@android:color/white"
                        android:backgroundTint="#FF1493"
                        app:cornerRadius="18dp"/>

                    <!-- טיפ -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="💡 אפשר להשאיר שנה ריקה"
                        android:textColor="#9B9B9B"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_marginTop="10dp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:background="#FFFFFF"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="#FF1493"
        app:itemTextColor="#FF1493"
        app:itemRippleColor="#33FF69B4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>